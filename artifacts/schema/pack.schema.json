{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/depalmar/edge-dfir-toolkit/artifacts/schema/pack.schema.json",
  "title": "Detection pack",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "platforms", "cves", "summary", "confidence", "references", "detect"],
  "properties": {
    "id": {"type": "string", "pattern": "^EDGE-PACK-[0-9]{4}$"},
    "name": {"type": "string"},
    "platforms": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^EDGE-[0-9]{4}$"}},
    "cves": {"type": "array", "items": {"type": "string", "pattern": "^CVE-[0-9]{4}-[0-9]{4,}$"}},
    "actors": {"type": "array", "items": {"type": "string"}},
    "implants": {"type": "array", "items": {"type": "string"}},
    "summary": {"type": "string"},
    "confidence": {"enum": ["high", "medium", "low"]},
    "unverified": {"type": "boolean"},
    "references": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["title", "url"],
        "properties": {"title": {"type": "string"}, "url": {"type": "string"}, "accessed": {"type": "string"}}
      }
    },
    "detect": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/detection"}}
  },
  "$defs": {
    "sources": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "steps": {"type": "array", "items": {"type": "string"}},
        "files": {"type": "array", "items": {"type": "string"}}
      }
    },
    "detection": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "title", "type", "tier", "evidence_class"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$"},
        "title": {"type": "string"},
        "type": {"enum": ["log_regex", "path_exists", "yara", "check"]},
        "tier": {"enum": ["possible", "likely", "confirmed"]},
        "evidence_class": {"enum": ["identity", "memory", "process", "sessions", "integrity", "config",
                                     "auth-logs", "web-logs", "system-logs", "filesystem", "persistence"]},
        "sources": {"$ref": "#/$defs/sources"},
        "pattern": {"type": "string"},
        "exclude": {"type": "array", "items": {"type": "string"}},
        "flags": {"type": "array", "items": {"enum": ["ignorecase"]}},
        "scope": {"type": "array", "items": {"type": "string"}},
        "paths": {"type": "array", "items": {"type": "string"}},
        "rule": {"type": "string"},
        "check": {"type": "string"},
        "args": {"type": "object"},
        "attack": {"type": "array", "items": {"type": "string", "pattern": "^T[0-9]{4}(\\.[0-9]{3})?$"}},
        "notes": {"type": "string"}
      },
      "allOf": [
        {"if": {"properties": {"type": {"const": "log_regex"}}}, "then": {"required": ["sources", "pattern"]}},
        {"if": {"properties": {"type": {"const": "path_exists"}}}, "then": {"required": ["paths"]}},
        {"if": {"properties": {"type": {"const": "yara"}}}, "then": {"required": ["rule", "sources"]}},
        {"if": {"properties": {"type": {"const": "check"}}}, "then": {"required": ["check"]}}
      ]
    }
  }
}
