{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/depalmar/edge-dfir-toolkit/artifacts/schema/ioc.schema.json",
  "title": "Indicator set from one publication",
  "description": "Indicators parsed from one publisher's own file or table, with the publisher's role and context for each value. Never retyped, never enriched.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "publisher", "published", "page_url", "file_format", "license", "accessed", "actors", "implants", "platforms", "staleness", "indicators"],
  "properties": {
    "id": {"type": "string", "pattern": "^EDGE-IOC-[0-9]{4}$"},
    "title": {"type": "string"},
    "publisher": {"type": "string"},
    "published": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "page_url": {"type": "string", "pattern": "^https://"},
    "file_url": {"type": "string", "pattern": "^https://"},
    "file_format": {"enum": ["csv", "stix-2.0", "stix-2.1", "text", "html-table", "html-list", "html-text"]},
    "license": {"type": "string"},
    "accessed": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "actors": {"type": "array", "items": {"type": "string", "pattern": "^EDGE-TA-[0-9]{4}$"}},
    "implants": {"type": "array", "items": {"type": "string", "pattern": "^EDGE-IMP-[0-9]{4}$"}},
    "cves": {"type": "array", "items": {"type": "string", "pattern": "^CVE-[0-9]{4}-[0-9]{4,}$"}},
    "platforms": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^EDGE-[0-9]{4}$"}},
    "staleness": {"type": "string", "description": "when the indicators were valid and why they may no longer be"},
    "indicators": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["type", "value", "role", "context"],
        "properties": {
          "type": {"enum": ["ipv4", "domain", "url", "sha256", "sha1", "md5", "ja3", "path", "account", "user-agent"]},
          "value": {"type": "string", "minLength": 1},
          "role": {"enum": ["actor-controlled", "compromised-infrastructure", "anonymiser", "multi-tenant", "suspected", "unknown"],
                   "description": "the publisher's own characterisation; unknown when it gives none"},
          "context": {"type": "string"}
        }
      }
    }
  }
}
